# JARVIS — Local AI Assistant configuration
# Copy this file to `.env` and adjust as needed.

# Node server port
PORT=3001

# Interface to bind. Defaults to 0.0.0.0 so other devices on the same WiFi can
# open the dashboard at http://<this-machine-ip>:3001 (the LAN URL is printed at
# startup). Set to 127.0.0.1 to keep JARVIS local-only.
# HOST=0.0.0.0

# Local ComfyUI instance used for image generation
COMFYUI_URL=http://127.0.0.1:8188

# Absolute path to ComfyUI's output folder. After each image is copied to
# data/generated/, the original in ComfyUI's output folder is deleted. Set this
# when the output dir can't be auto-detected from ComfyUI's argv (e.g. it is
# not the default <ComfyUI>/output).
# COMFYUI_OUTPUT_DIR=E:\ComfyUI\output

# Generation timeout in milliseconds (default 15 minutes)
COMFYUI_TIMEOUT_MS=900000

# Optional: how JARVIS starts ComfyUI when the COMFYUI widget's Start button
# (or "start ComfyUI" in chat) is used. By default JARVIS auto-detects a
# ComfyUI Desktop install or a portable/venv layout. Set COMFYUI_START_CMD to
# a full shell command to override detection entirely (e.g. a desktop app or a
# custom launcher script), and COMFYUI_START_TIMEOUT_MS to change how long to
# wait for the API to come online (default 180000 = 3 minutes).
# COMFYUI_START_CMD="C:\Path\To\ComfyUI\run_nvidia_gpu.bat"
# COMFYUI_START_TIMEOUT_MS=180000

# --- Optional Krea2 model overrides ---
# These match the Krea2 assets the setup guide installs into ComfyUI. Only set them
# if your model filenames differ from the defaults.

# KREA2_UNET=krea2_turbo_fp8_scaled.safetensors
# KREA2_CLIP=Huihui-Qwen3-VL-4B-Instruct-abliterated-fp8_scaled.safetensors
# KREA2_CLIP_TYPE=krea2
# KREA2_VAE=wan_2.1_vae.safetensors

# --- Optional Qwen Image 2.1 model overrides ---
# Select the active text-to-image model with JARVIS_IMAGE_MODEL (krea2 or
# qwen_image_2_1, the default); the Settings > Image IMAGE MODEL dropdown writes
# the same setting. Only set the QWEN_IMAGE_* filenames if yours differ from the
# Comfy-Org/Qwen-Image-2.1 defaults the setup guide installs. Image editing
# ALWAYS uses the Qwen Image 2.1 editor, regardless of the generation model.
# JARVIS_IMAGE_MODEL=qwen_image_2_1
# QWEN_IMAGE_UNET=qwen_image_2.1_int8_convrot.safetensors
# QWEN_IMAGE_CLIP=qwen3vl_8b_int8_convrot.safetensors
# QWEN_IMAGE_VAE=qwen_image_2.1_vae_bf16.safetensors

# --- Optional generation defaults ---
# Aspect ratio (1:1, 4:5, 3:4, 16:9, 9:16) and size (S 0.75MP / M 1MP /
# L 1.25MP / XL 1.75MP total pixels) used to derive the Krea2
# latent dimensions.
# KREA2_ASPECT_RATIO=4:5
# KREA2_IMAGE_SIZE=M
# KREA2_WIDTH=1024
# KREA2_HEIGHT=1024
# KREA2_STEPS=8
# KREA2_CFG=1

# --- Optional upscaling (SeedVR2 / Ultimate SD / RTX video) ---
# Directories where ComfyUI keeps SeedVR2 DiT/VAE checkpoints. When unset the
# server scans <ComfyUI>/models/seedvr2 (also overridable with COMFYUI_MODEL_DIR).
# KREA2_SEEDVR2_DIR=E:\ComfyUI\models\seedvr2
# COMFYUI_SEEDVR2_DIR=E:\ComfyUI\models\SeedVR2

# Absolute path to ComfyUI's install folder (the one containing main.py).
# Auto-detected for portable installs and Comfy Desktop; set this only when
# auto-detection fails (needed by the FaceRefine auto-installer).
# COMFYUI_ROOT=E:\Comfy-Desktop\ComfyUI-Installs\ComfyUI\ComfyUI
# Python executable from that ComfyUI install, used by Setup when a node pack
# has Python requirements. Normally auto-detected from ComfyUI's runtime.
# COMFYUI_PYTHON=E:\ComfyUI\.venv\Scripts\python.exe

# Absolute paths to ComfyUI's models/ and input/ folders, used to discover
# upscale models and clean up uploaded sources. Auto-detected from ComfyUI's
# argv when unset.
# COMFYUI_MODEL_DIR=E:\ComfyUI\models
# COMFYUI_INPUT_DIR=E:\ComfyUI\input

# --- First-run model setup (Settings > Setup) ---
# Token for gated Hugging Face repos (Krea 2, MiniMax H3). Prefer pasting it
# into Settings > Setup (stored in data/config.json); set one of these only
# to override on machines where the settings file is shared or reset.
# HF_TOKEN=hf_...
# HUGGINGFACE_TOKEN=hf_...

# --- Optional MiniMax H3 video generation ---
# H3 is image-to-video only: it animates a single first frame (or is text-only
# when no frame is supplied). Character identity is resolved upstream by Qwen
# Image 2.1 into that frame; H3 never receives reference images. UNET:
# H3_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
# VAE models (shared between modes):
# H3_VAE=minimax_h3_video_vae_int8_convrot.safetensors
# H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# CLIP model (must match the UNET variant — fp4 for int8 UNETs, fp8 for fp16):
# H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# Default video size: S (0.75MP), M (1MP), L (1.25MP), or XL (1.75MP, native canvas).
# XL is the model's native canvas and the quality-first default.
# H3_SIZE=XL
# Global output aspect ratio for normal, UGC, and Creator Studio videos.
# H3_ASPECT_RATIO=16:9
# Default duration in seconds (5–15). Default:
# H3_DURATION=5
# Default sampling steps (1–100) for the normal (≤15s) H3 video pipeline.
# H3_STEPS=25
# Default CFG guidance scale for H3 video. 1 = unguided (default); values above
# 1 add a negative-conditioning guidance pass. Default:
# H3_CFG=1
# Default attention backend: auto, comfykitchen, sageattention, or sla.
# sageattention is the verified default; `auto` picks the best backend ComfyUI
# offers (comfy kitchen attention first, then sageattention, else dense PyTorch).
# H3_ATTENTION_BACKEND=sageattention

# MiniMax H3 Turbo LoRA (4-8 step generation). ON by default: JARVIS routes the
# H3 model through the MiniMax-H3 Turbo LoRA + Turbo sampler
# (github.com/larryvrh/ComfyUI-MiniMax-H3-Turbo) and switches to `simple`
# scheduling at the model's native canvas. The LoRA file must live in
# ComfyUI/models/loras (default below). Video settings saved in
# data/config.json win over these. LoRA strength (1.0) is fixed; valid 4-8.
# Set H3_TURBO_ENABLED=false to use the full 25-step base workflow.
# H3_TURBO_ENABLED=true
# H3_TURBO_STEPS=6
# H3_TURBO_LORA=minimax_h3_turbo_v4_step600_ema.safetensors
# Sigma-shift MODEL patch for LightX2V standard-loader Turbo adapters.
# H3_TURBO_SIGMA_SHIFT=true

# MiniMax H3 First Block Cache (duckyshell/ComfyUI-MiniMaxH3-FirstBlockCache).
# Optional MODEL patch that reduces redundant transformer computation. It is an
# approximation, not lossless. Off by default. Requires the custom node in
# ComfyUI/custom_nodes (no extra Python packages); JARVIS reports a friendly
# error if it is missing. Composes with the attention backend and Turbo LoRA.
# `mode` uses the node's exact preset strings ("H3 Safe — 0.08 / max 2",
# "H3 Fast — 0.10 / max 2", "H3 Aggressive — 0.12 / max 2",
# "H3 Experimental", "Custom — manual values"). Custom values only apply in
# Custom mode. Video settings saved in data/config.json win over these.
# H3_FBCACHE_ENABLED=false
# H3_FBCACHE_MODE=H3 Fast — 0.10 / max 2
# H3_FBCACHE_THRESHOLD=0.10
# H3_FBCACHE_START=0.10
# H3_FBCACHE_END=0.95
# H3_FBCACHE_MAX_HITS=2
# H3_FBCACHE_TEMPORAL_GUARD=false

# --- Optional H3 LongVideos (Long Video Director, >15s videos) ---
# Videos longer than H3's 15-second ceiling route to the Long Video Director,
# which plans a Story Bible + beats, shows the storyboard for approval, then
# submits one prompt to the installed Smite79/MiniMax-H3-LongVideos ComfyUI
# node. The node chains the beats internally (no external frame extraction and
# no clip concatenation). Install it into ComfyUI/custom_nodes and restart
# ComfyUI; JARVIS reports a friendly error if it is missing.
# H3_LONGVIDEO_MAX_SECONDS=120
# H3_LONGVIDEO_STEPS=20
# Long videos render many beats, so the default timeout is 90 minutes.
# H3_LONGVIDEO_TIMEOUT_MS=5400000

# --- Optional H3 FaceRefine post-process (small/distant faces) ---
# Second H3 pass after each video when enabled in Settings > Video: tracks
# faces per frame, re-generates the crops at low denoise, stitches them back.
# Needs ComfyUI-H3-FaceRefine + face_yolov8m.pt in ComfyUI — auto-installed
# into ComfyUI on first enable (restart ComfyUI when it finishes).
# Stored videoGeneration settings in data/config.json win over these.
# H3_FACEREFINE_ENABLED=false
# H3_FACEREFINE_DETECTOR=face_yolov8m.pt
# H3_FACEREFINE_DENOISE=0.4
# H3_FACEREFINE_STEPS=8
# H3_FACEREFINE_CROP=2.5
# H3_FACEREFINE_CANVAS=auto_capped_768
# H3_FACEREFINE_SELECT=largest_face
# H3_FACEREFINE_FEATHER=24

# --- Optional H3 frame interpolation (double frame rate) ---
# Post-process after each video when enabled in Settings > Video: synthesises
# intermediate frames with the RIFE VFI node so the clip plays at a higher
# frame rate (2x default: 24 -> 48 fps; 3x/4x also supported). Needs the
# ComfyUI-Frame-Interpolation custom node (Fannovel16) — auto-cloned into
# ComfyUI on first enable, then its install.py installs the runtime deps
# (restart ComfyUI when it finishes). The RIFE checkpoint downloads on first
# use. Off by default; fail-open (a failed interpolation keeps the base render).
# Video settings saved in data/config.json win over these.
# H3_FRAME_INTERP_ENABLED=false
# H3_FRAME_INTERP_MULTIPLIER=2
# H3_FRAME_INTERP_MODEL=rife49.pth

# --- Optional H3 Latent Upscale + refinement ---
# Three-stage MiniMax H3 pipeline: generate a low-res AV latent, upscale the
# 24-channel video latent with the learned 3D upscaler, then re-sample (refine)
# at the target resolution before one VAE decode. Saves TIME, not VRAM: the
# refinement still runs at the target resolution. Model + node pack:
#   https://github.com/LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler
#   https://huggingface.co/LBH-123-AI/Minimax_h3_latent_Upscaler
# `auto` picks a scale from the requested output size and falls back to direct
# generation when the model/node is missing. `off` keeps the plain H3 workflow.
# Explicit scales (1.5/2/2.5/3/4) fail clearly if the model is not installed.
# Video settings saved in data/config.json win over these.
# H3_LATENT_UPSCALE=auto
# H3_LATENT_UPSCALE_MODEL=minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors
# H3_LATENT_UPSCALE_STRENGTH=0.35
# H3_LATENT_UPSCALE_PRECISION=fp16
# H3_LATENT_UPSCALE_TEMPORAL_CHUNKING=true
# H3_LATENT_UPSCALE_FORCE_UNLOAD=true

# --- Optional auto-upscale of every generated video ---
# When enabled in Settings > Video, the video upscale pipeline (shared
# UPSCALE settings: engine, resolution, profile) runs on every generated
# video. The original clip is kept so the gallery can compare the pair
# side by side. Off by default; best-effort (a failed upscale keeps the
# base render).
# H3_AUTO_UPSCALE_ENABLED=false

# --- Shared upscale tuning (SeedVR2 / RTX for video, SeedVR2 / Ultimate SD for images) ---
# Upscaling reads the single UPSCALE settings panel (stored in
# data/config.json under imageGeneration). No per-video overrides exist.
# Engine is shared but mapped per medium: videos run SeedVR2
# or fast RTX (default, Ultimate SD falls back to RTX); images run SeedVR2 or
# Ultimate SD (RTX falls back to SeedVR2). RTX video upscale uses the
# multiplier as its scale factor; SeedVR2 uses the target resolution.

# --- Optional gallery video posters ---
# The gallery mints a poster frame for generated videos with ffmpeg when it is
# available on PATH (or pointed to by FFMPEG_PATH). When ffmpeg is unavailable,
# video tiles fall back to a play-icon placeholder. This is not an npm
# dependency — it is only used if present.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# --- Model eviction ---
# Ollama and ComfyUI are never resident at the same time. Before any chat work
# JARVIS unloads ComfyUI models; before any image/video generation it unloads
# every chat model Ollama has loaded. There are no memory thresholds to tune.
#
# Unloads are verified, not fire-and-forget: Ollama's keep_alive 0 only schedules
# the eviction, so JARVIS polls /api/ps until the model is actually gone (then
# holds a short settle) before ComfyUI loads. This stops a still-resident
# llama-server from being stacked on top of the video model and freezing the
# machine. Timeout is the max wait for a model to disappear; poll is the
# /api/ps check interval; settle is the pause after the model is gone (and
# after a ComfyUI /free) to let the OS/driver reclaim the memory.
# JARVIS_MODEL_RELEASE_TIMEOUT_MS=30000
# JARVIS_MODEL_RELEASE_POLL_MS=500
# JARVIS_MODEL_RELEASE_SETTLE_MS=1500

# --- Intent Resolver debugging ---
# Set to 1 to print, per turn, the resolved structured intent, the regex/keyword
# evidence, and the final action. Development only; not shown in the UI.
# JARVIS_INTENT_DEBUG=1

# --- Image prompt debugging ---
# Set to 1 to print the resolved image instruction for a character generation,
# including whether clothing/style were explicit or automatically selected.
# Development only; not shown in the UI.
# JARVIS_PROMPT_DEBUG=1

# --- Playground outfit-resolution debugging ---
# Set to 1 to print the environment/outfit compatibility resolution (selected
# pack, environment, scene, initial outfit, adaptations and final outfit) and to
# expose it on the Playground concept card. Development only; never shown to
# normal users and never written into an image prompt.
# JARVIS_PLAYGROUND_DEBUG=1

# --- Creator Studio dialogue debugging ---
# Set to 1 to print the canonical normalized Creator Studio dialogue object
# before the deterministic H3 prompt is assembled, then the final H3 prompt.
# Development only; never shown in the UI and never written into the prompt.
# JARVIS_CREATOR_DEBUG=1
