# JARVIS — Local AI Assistant configuration
# Copy this file to `.env` and adjust as needed.

# Node server port
PORT=3001

# Local ComfyUI instance used for image generation
COMFYUI_URL=http://127.0.0.1:8188

# Absolute path to ComfyUI's output folder. After each image is copied to
# data/generated/, the original in ComfyUI's output folder is deleted. Set this
# when the output dir can't be auto-detected from ComfyUI's argv (e.g. it is
# not the default <ComfyUI>/output).
# COMFYUI_OUTPUT_DIR=E:\ComfyUI\output

# Generation timeout in milliseconds (default 15 minutes)
COMFYUI_TIMEOUT_MS=900000

# --- Optional Krea2 model overrides ---
# These match the Krea2 assets Mix Studio installs into ComfyUI. Only set them
# if your model filenames differ from the defaults.

# KREA2_UNET=krea2_turbo_fp8_scaled.safetensors
# KREA2_CLIP=Huihui-Qwen3-VL-4B-Instruct-abliterated-fp8_scaled.safetensors
# KREA2_CLIP_TYPE=krea2
# KREA2_VAE=wan_2.1_vae.safetensors
# Identity Edit LoRA for "edit this image" (Krea2 instruction edits, needs
# the comfyui-krea2edit custom nodes). Default:
# KREA2_EDIT_LORA=krea2_identity_edit_v1_2.safetensors

# --- Optional generation defaults ---
# Aspect ratio (1:1, 4:5, 3:4, 16:9, 9:16) and size (S 0.75MP / M 1MP /
# L 1.75MP total pixels, matching Mix Studio) used to derive the Krea2
# latent dimensions.
# KREA2_ASPECT_RATIO=4:5
# KREA2_IMAGE_SIZE=M
# KREA2_WIDTH=1024
# KREA2_HEIGHT=1024
# KREA2_STEPS=8
# KREA2_CFG=1

# Match AUTO LoRA keywords against the raw user message before the LLM
# rewrites the prompt (default on). Set to false to match only the final prompt.
# KREA2_AUTO_LORA_PRE_LLM=true

# --- Optional upscaling (SeedVR2 / Ultimate SD / RTX video) ---
# Directories where ComfyUI keeps SeedVR2 DiT/VAE checkpoints. When unset the
# server scans <ComfyUI>/models/seedvr2 (also overridable with COMFYUI_MODEL_DIR).
# KREA2_SEEDVR2_DIR=E:\ComfyUI\models\seedvr2
# COMFYUI_SEEDVR2_DIR=E:\ComfyUI\models\SeedVR2

# Absolute path to ComfyUI's install folder (the one containing main.py).
# Auto-detected for portable installs and Comfy Desktop; set this only when
# auto-detection fails (needed by the FaceRefine auto-installer).
# COMFYUI_ROOT=E:\Comfy-Desktop\ComfyUI-Installs\ComfyUI\ComfyUI

# Absolute paths to ComfyUI's models/ and input/ folders, used to discover
# upscale models and clean up uploaded sources. Auto-detected from ComfyUI's
# argv when unset.
# COMFYUI_MODEL_DIR=E:\ComfyUI\models
# COMFYUI_INPUT_DIR=E:\ComfyUI\input

# --- First-run model setup (Settings > Setup) ---
# Token for gated Hugging Face repos (Krea 2, MiniMax H3). Prefer pasting it
# into Settings > Setup (stored in data/config.json); set one of these only
# to override on machines where the settings file is shared or reset.
# HF_TOKEN=hf_...
# HUGGINGFACE_TOKEN=hf_...

# --- Optional MiniMax H3 video generation ---
# UNET for T2VA (text-to-video-audio) mode. Default:
# H3_UNET_T2VA=minimax_h3_fl2va_pruned_int8_convrot.safetensors
# UNET for I2VA (image-to-video-audio) mode. Default:
# H3_UNET_I2VA=minimax_h3_ref2va_pruned_int8_convrot.safetensors
# VAE models (shared between modes):
# H3_VAE=minimax_h3_video_vae_fp16.safetensors
# H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# CLIP model (must match the UNET variant — fp4 for int8 UNETs, fp8 for fp16):
# H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# Default video size: S (0.75MP), M (1MP), or L (1.75MP, native canvas)
# H3_SIZE=M
# Default duration in seconds (5–15). Default:
# H3_DURATION=5
# Default attention backend: standard, sageattention, or sla
# H3_ATTENTION_BACKEND=standard

# --- Optional H3 FaceRefine post-process (small/distant faces) ---
# Second H3 pass after each video when enabled in Settings > Video: tracks
# faces per frame, re-generates the crops at low denoise, stitches them back.
# Needs ComfyUI-H3-FaceRefine + face_yolov8m.pt in ComfyUI — auto-installed
# into ComfyUI on first enable (restart ComfyUI when it finishes).
# Stored videoGeneration settings in data/config.json win over these.
# H3_FACEREFINE_ENABLED=false
# H3_FACEREFINE_DETECTOR=face_yolov8m.pt
# H3_FACEREFINE_DENOISE=0.4
# H3_FACEREFINE_STEPS=8
# H3_FACEREFINE_CROP=2.5
# H3_FACEREFINE_CANVAS=auto_capped_768
# H3_FACEREFINE_SELECT=largest_face
# H3_FACEREFINE_FEATHER=24

# --- Shared upscale tuning (SeedVR2 / RTX for video, SeedVR2 / Ultimate SD for images) ---
# Upscaling reads the single UPSCALE settings panel (stored in
# data/config.json under imageGeneration). No per-video overrides exist.
# Engine is shared but mapped per medium like Mix Studio: videos run SeedVR2
# or fast RTX (default, Ultimate SD falls back to RTX); images run SeedVR2 or
# Ultimate SD (RTX falls back to SeedVR2). RTX video upscale uses the
# multiplier as its scale factor; SeedVR2 uses the target resolution.

# --- Optional gallery video posters ---
# The gallery mints a poster frame for generated videos with ffmpeg when it is
# available on PATH (or pointed to by FFMPEG_PATH). When ffmpeg is unavailable,
# video tiles fall back to a play-icon placeholder. This is not an npm
# dependency — it is only used if present.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe