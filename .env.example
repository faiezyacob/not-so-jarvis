# JARVIS â€” Local AI Assistant configuration
# Copy this file to `.env` and adjust as needed.

# Node server port
PORT=3001

# Interface to bind. Defaults to 0.0.0.0 so other devices on the same WiFi can
# open the dashboard at http://<this-machine-ip>:3001 (the LAN URL is printed at
# startup). Set to 127.0.0.1 to keep JARVIS local-only.
# HOST=0.0.0.0

# Local ComfyUI instance used for image generation
COMFYUI_URL=http://127.0.0.1:8188

# Absolute path to ComfyUI's output folder. After each image is copied to
# data/generated/, the original in ComfyUI's output folder is deleted. Set this
# when the output dir can't be auto-detected from ComfyUI's argv (e.g. it is
# not the default <ComfyUI>/output).
# COMFYUI_OUTPUT_DIR=E:\ComfyUI\output

# Generation timeout in milliseconds (default 15 minutes)
COMFYUI_TIMEOUT_MS=900000

# Optional: how JARVIS starts ComfyUI when the COMFYUI widget's Start button
# (or "start ComfyUI" in chat) is used. By default JARVIS auto-detects a
# ComfyUI Desktop install or a portable/venv layout. Set COMFYUI_START_CMD to
# a full shell command to override detection entirely (e.g. a desktop app or a
# custom launcher script), and COMFYUI_START_TIMEOUT_MS to change how long to
# wait for the API to come online (default 180000 = 3 minutes).
# COMFYUI_START_CMD="C:\Path\To\ComfyUI\run_nvidia_gpu.bat"
# COMFYUI_START_TIMEOUT_MS=180000

# --- Optional Krea2 model overrides ---
# These match the Krea2 assets the setup guide installs into ComfyUI. Only set them
# if your model filenames differ from the defaults.

# KREA2_UNET=krea2_turbo_fp8_scaled.safetensors
# KREA2_CLIP=Huihui-Qwen3-VL-4B-Instruct-abliterated-fp8_scaled.safetensors
# KREA2_CLIP_TYPE=krea2
# KREA2_VAE=wan_2.1_vae.safetensors

# --- Optional Qwen Image 2.1 model overrides ---
# Select the active text-to-image model with JARVIS_IMAGE_MODEL (krea2 or
# qwen_image_2_1, the default); the Settings > Image IMAGE MODEL dropdown writes
# the same setting. Only set the QWEN_IMAGE_* filenames if yours differ from the
# Comfy-Org/Qwen-Image-2.1 defaults the setup guide installs. Image editing uses
# the engine chosen by JARVIS_EDIT_ENGINE / Settings > Image IMAGE EDIT.
# JARVIS_IMAGE_MODEL=qwen_image_2_1
# QWEN_IMAGE_UNET=qwen_image_2.1_int8_convrot.safetensors
# QWEN_IMAGE_CLIP=qwen3vl_8b_int8_convrot.safetensors
# QWEN_IMAGE_VAE=qwen_image_2.1_vae_bf16.safetensors

# --- Image attention backend (Settings > Image > SAMPLING) ---
# Accelerated attention for BOTH image pipelines (Krea 2 and Qwen Image 2.1):
# auto (default), comfykitchen, or sageattention. `auto` resolves against
# ComfyUI's available patches (Comfy Kitchen first, then SageAttention) and
# leaves dense PyTorch attention untouched when neither is installed.
# JARVIS_IMAGE_ATTENTION=auto

# --- Image edit engine (Settings > Image > IMAGE EDIT) ---
# Which pipeline edits an existing image: `qwen` (default) uses the native Qwen
# Image 2.1 instruction editor (TextEncodeQwenImage21) with multi-reference
# support; `krea2` uses the Krea 2 Identity Edit pipeline (comfyui-krea2edit
# nodes + the Identity Edit LoRA), a reference-guided edit that preserves a
# subject's identity and uses at most one extra reference image. The Krea 2
# engine reads the Krea 2 base models (KREA2_UNET/CLIP/VAE) and needs the
# Identity Edit LoRA + node pack installed (Settings > Setup).
# JARVIS_EDIT_ENGINE=qwen
# KREA2_IDENTITY_EDIT_LORA=krea2_identity_edit_v1_2.safetensors

# --- Optional generation defaults ---
# Aspect ratio (1:1, 4:5, 3:4, 16:9, 9:16) and size (S 0.75MP / M 1MP /
# L 1.25MP / XL 1.75MP total pixels) used to derive the Krea2
# latent dimensions.
# KREA2_ASPECT_RATIO=4:5
# KREA2_IMAGE_SIZE=M
# KREA2_WIDTH=1024
# KREA2_HEIGHT=1024
# KREA2_STEPS=8
# KREA2_CFG=1

# --- Optional upscaling (SeedVR2 / Ultimate SD / RTX video) ---
# Directories where ComfyUI keeps SeedVR2 DiT/VAE checkpoints. When unset the
# server scans <ComfyUI>/models/seedvr2 (also overridable with COMFYUI_MODEL_DIR).
# KREA2_SEEDVR2_DIR=E:\ComfyUI\models\seedvr2
# COMFYUI_SEEDVR2_DIR=E:\ComfyUI\models\SeedVR2

# Absolute path to ComfyUI's install folder (the one containing main.py).
# Auto-detected for portable installs and Comfy Desktop; set this only when
# auto-detection fails (needed by the FaceRefine auto-installer).
# COMFYUI_ROOT=E:\Comfy-Desktop\ComfyUI-Installs\ComfyUI\ComfyUI
# Python executable from that ComfyUI install, used by Setup when a node pack
# has Python requirements. Normally auto-detected from ComfyUI's runtime.
# COMFYUI_PYTHON=E:\ComfyUI\.venv\Scripts\python.exe

# Absolute paths to ComfyUI's models/ and input/ folders, used to discover
# upscale models and clean up uploaded sources. Auto-detected from ComfyUI's
# argv when unset.
# COMFYUI_MODEL_DIR=E:\ComfyUI\models
# COMFYUI_INPUT_DIR=E:\ComfyUI\input

# --- First-run model setup (Settings > Setup) ---
# Token for gated Hugging Face repos (Krea 2, MiniMax H3). Prefer pasting it
# into Settings > Setup (stored in data/config.json); set one of these only
# to override on machines where the settings file is shared or reset.
# HF_TOKEN=hf_...
# HUGGINGFACE_TOKEN=hf_...

# --- Optional MiniMax H3 video generation ---
# H3 is image-to-video only for normal generation: it animates a single first
# frame (or is text-only when no frame is supplied). Character identity is
# resolved upstream by Qwen Image 2.1 into that frame; H3 never receives
# reference images. The @video character-replacement path is the exception: it
# runs on the Ref2VA model with MiniMaxH3ReferenceToVideo (source video +
# reference images). UNET:
# H3_UNET=minimax_h3_fl2va_pruned_int8_convrot.safetensors
# Reference-to-video UNET for @video character replacement (auto-detected from
# the installed *ref2va* model when unset):
# H3_REF_UNET=minimax_h3_ref2va_pruned_int8_convrot.safetensors
# VAE models (shared between modes):
# H3_VAE=minimax_h3_video_vae_int8_convrot.safetensors
# H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# CLIP model (must match the UNET variant â€” fp4 for int8 UNETs, fp8 for fp16):
# H3_CLIP=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# Default video size: S (0.75MP), M (1MP), L (1.25MP), or XL (1.75MP, native canvas).
# XL is the model's native canvas and the quality-first default.
# H3_SIZE=XL
# Global output aspect ratio for normal, UGC, and Creator Studio videos.
# H3_ASPECT_RATIO=16:9
# Default duration in seconds (5â€“15). Default:
# H3_DURATION=5
# Default sampling steps (1â€“100) for the normal (â‰¤15s) H3 video pipeline.
# H3_STEPS=25
# Default CFG guidance scale for H3 video. 1 = unguided (default); values above
# 1 add a negative-conditioning guidance pass. Default:
# H3_CFG=1
# Default attention backend: auto, comfykitchen, sageattention, or sla.
# sageattention is the verified default; `auto` picks the best backend ComfyUI
# offers (comfy kitchen attention first, then sageattention, else dense PyTorch).
# H3_ATTENTION_BACKEND=sageattention

# MiniMax H3 Turbo LoRA (4-8 step generation). ON by default: JARVIS routes the
# H3 model through the MiniMax-H3 Turbo LoRA + Turbo sampler
# (github.com/larryvrh/ComfyUI-MiniMax-H3-Turbo) and switches to `simple`
# scheduling at the model's native canvas. The LoRA file must live in
# ComfyUI/models/loras (default below). Video settings saved in
# data/config.json win over these. LoRA strength (1.0) is fixed; valid 4-8.
# Set H3_TURBO_ENABLED=false to use the full 25-step base workflow.
# H3_TURBO_ENABLED=true
# H3_TURBO_STEPS=6
# H3_TURBO_LORA=minimax_h3_turbo_v4_step600_ema.safetensors
# Sigma-shift MODEL patch for LightX2V standard-loader Turbo adapters.
# H3_TURBO_SIGMA_SHIFT=true

# MiniMax H3 Character Swap LoRA (akatz-ai/MiniMax-H3-Character-Swap-LoRA).
# Model-only adapter used by the @video character-replacement path: replace a
# person in an existing clip with the identity from an @image reference. ON by
# default (the reference pipeline exists to swap characters). The LoRA file must
# live in ComfyUI/models/loras (default below); download it from Settings > Setup
# ("H3 Character Swap LoRA"). Applied at strength 1.0 immediately after the
# Ref2VA diffusion-model loader. Set H3_CHAR_SWAP_ENABLED=false to run the
# replacement graph on the stock Ref2VA base instead.
# H3_CHAR_SWAP_ENABLED=true
# H3_CHAR_SWAP_LORA=h3_character_swap_v1.5.safetensors
# H3_CHAR_SWAP_STRENGTH=1.0
#
# The character-swap adapter is SINGLE-IDENTITY. It is applied to any
# single-target swap (which is what makes the person actually get replaced) and
# never to a multi-target one, where the native multi-reference path honours
# every <Picture N>.
#
# Reference image sizing for the replacement node: auto (default) uses the
# high-fidelity 2048px short edge when clothing/appearance is transferred and
# the generation-area `match` otherwise. Force `match` (cheaper) or `max`.
# H3_REPLACEMENT_REF_IMAGE_SIZE=auto
#
# Opt-in subject-mask background preservation. When ON, the target person is
# segmented with SAM3 (core ComfyUI nodes only: SAM3_Detect -> SAM3_VideoTrack
# -> SAM3_TrackToMask), grown, and the generated subject is composited back onto
# the ORIGINAL source frames — so the background and non-target people keep
# their original pixels instead of being regenerated. Off by default (it loads
# the SAM3 checkpoint and tracks every frame). Needs the SAM3 checkpoint in
# ComfyUI/models/checkpoints.
# H3_REPLACEMENT_MASK=false
# H3_REPLACEMENT_MASK_MODEL=sam3.1_multiplex_fp16.safetensors
# H3_REPLACEMENT_MASK_GROW=64
# H3_REPLACEMENT_MASK_PROMPT=
#
# Note: without the mask, the native MiniMaxH3ReferenceToVideo node regenerates
# the whole frame from the source-video + reference-image conditioning and has
# no mask/region input, so the background is requested to stay the source's but
# is not pixel-preserved.

# MiniMax H3 First Block Cache (duckyshell/ComfyUI-MiniMaxH3-FirstBlockCache).
# Optional MODEL patch that reduces redundant transformer computation. It is an
# approximation, not lossless. Off by default. Requires the custom node in
# ComfyUI/custom_nodes (no extra Python packages); JARVIS reports a friendly
# error if it is missing. Composes with the attention backend and Turbo LoRA.
# `mode` uses the node's exact preset strings ("H3 Safe â€” 0.08 / max 2",
# "H3 Fast â€” 0.10 / max 2", "H3 Aggressive â€” 0.12 / max 2",
# "H3 Experimental", "Custom â€” manual values"). Custom values only apply in
# Custom mode. Video settings saved in data/config.json win over these.
# H3_FBCACHE_ENABLED=false
# H3_FBCACHE_MODE=H3 Fast â€” 0.10 / max 2
# H3_FBCACHE_THRESHOLD=0.10
# H3_FBCACHE_START=0.10
# H3_FBCACHE_END=0.95
# H3_FBCACHE_MAX_HITS=2
# H3_FBCACHE_TEMPORAL_GUARD=false

# --- Optional H3 LongVideos (Long Video Director, >15s videos) ---
# Videos longer than H3's 15-second ceiling route to the Long Video Director,
# which plans a Story Bible + beats, shows the storyboard for approval, then
# renders them. Two engines:
#   longtake     - the H3-LongTakeNoCuts technique (recommended): each beat is
#                  conditioned on the previous beat's SAMPLER-OUTPUT LATENT
#                  (no decode/re-encode), refined at low denoise, then blended
#                  back in latent space by frame. Needs the ComfyUI node packs
#                  NikoDemon80/ComfyUI-H3-Motion-Context + xyzDist/H3-LongTakeNoCuts
#                  (auto-installed on first use, or Settings > Setup / the
#                  /api/video/longtake/install endpoint).
#   h3longvideos - the legacy Smite79/MiniMax-H3-LongVideos AIO node (kept for
#                  backward compatibility; chains beats by decoded last frame).
# `auto` (default) uses longtake when its nodes are installed, else h3longvideos.
# H3_LONGVIDEO_ENGINE=auto
# H3_LONGVIDEO_MAX_SECONDS=120
# H3_LONGVIDEO_STEPS=20
# Long videos render many beats, so the default timeout is 90 minutes.
# H3_LONGVIDEO_TIMEOUT_MS=5400000

# Auto-upscale (Settings > Video) is applied to a long video only when it is
# within this safe duration cap. The file-based upscale graph loads the WHOLE
# clip into one batch, so longer clips are skipped (and logged) to avoid OOM.
# 20s (~480 frames) is safe on a normal machine; lower it if you run out of RAM.
# H3_LONGVIDEO_UPSCALE_MAX_SECONDS=20

# --- Long-video re-anchor (H3-LongTake-style consistency) ---
# Fills the node's `anchor` (scene/style/lighting) and `character_memory`
# (identity/wardrobe) channels from the approved Story Bible on every shot, so
# the decode/handoff chain cannot let identity, appearance, clothing,
# environment or lighting drift as the video gets longer (the H3-LongTakeNoCuts
# re-anchor principle, adapted for the H3LongVideos node). Default on. Set
# H3_LONGTAKE_REANCHOR=false (or videoGeneration.longTake.reanchor=false) to
# disable it for a faithful before/after comparison.
# H3_LONGTAKE_REANCHOR=true

# --- LongTake engine refine + latent frame-blend (longtake engine only) ---
# OPTIONAL and OFF by default. The refine resamples each beat at low denoise and
# blends the raw sample into the refined latent by frame. It exists to repair a
# latent that has already degraded after many beats, but on an already-consistent
# chain it introduces its own visible shift (a drift ~2s into each beat, then the
# refined look to the end). Enable only if a very long video degrades, and keep
# the denoise low. Motion-context continuity always applies.
# H3_LONGTAKE_REFINE=false
# H3_LONGTAKE_REFINE_DENOISE=0.5
# H3_LONGTAKE_REFINE_STEPS=2
# H3_LONGTAKE_BLEND_KEYFRAMES=0:0, 22:0, 44:1

# --- Optional H3 FaceRefine post-process (small/distant faces) ---
# Second H3 pass after each video when enabled in Settings > Video: tracks
# faces per frame, re-generates the crops at low denoise, stitches them back.
# Needs ComfyUI-H3-FaceRefine + face_yolov8m.pt in ComfyUI â€” auto-installed
# into ComfyUI on first enable (restart ComfyUI when it finishes).
# Stored videoGeneration settings in data/config.json win over these.
# H3_FACEREFINE_ENABLED=false
# H3_FACEREFINE_DETECTOR=face_yolov8m.pt
# H3_FACEREFINE_DENOISE=0.4
# H3_FACEREFINE_STEPS=8
# H3_FACEREFINE_CROP=2.5
# H3_FACEREFINE_CANVAS=auto_capped_768
# H3_FACEREFINE_SELECT=largest_face
# H3_FACEREFINE_FEATHER=24

# --- Optional H3 frame interpolation (double frame rate) ---
# Post-process after each video when enabled in Settings > Video: synthesises
# intermediate frames with the RIFE VFI node so the clip plays at a higher
# frame rate (2x default: 24 -> 48 fps; 3x/4x also supported). Needs the
# ComfyUI-Frame-Interpolation custom node (Fannovel16) â€” auto-cloned into
# ComfyUI on first enable, then its install.py installs the runtime deps
# (restart ComfyUI when it finishes). The RIFE checkpoint downloads on first
# use. Off by default; fail-open (a failed interpolation keeps the base render).
# Video settings saved in data/config.json win over these.
# H3_FRAME_INTERP_ENABLED=false
# H3_FRAME_INTERP_MULTIPLIER=2
# H3_FRAME_INTERP_MODEL=rife49.pth

# --- Optional H3 Latent Upscale + refinement ---
# Three-stage MiniMax H3 pipeline: generate a low-res AV latent, upscale the
# 24-channel video latent with the learned 3D upscaler, then re-sample (refine)
# at the target resolution before one VAE decode. Saves TIME, not VRAM: the
# refinement still runs at the target resolution. Model + node pack:
#   https://github.com/LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler
#   https://huggingface.co/LBH-123-AI/Minimax_h3_latent_Upscaler
# `auto` picks a scale from the requested output size and falls back to direct
# generation when the model/node is missing. `off` keeps the plain H3 workflow.
# Explicit scales (1.5/2/2.5/3/4) fail clearly if the model is not installed.
# Video settings saved in data/config.json win over these.
# H3_LATENT_UPSCALE=auto
# H3_LATENT_UPSCALE_MODEL=minimax_h3_latent_upscaler_3d_conv_v1_fp16.safetensors
# H3_LATENT_UPSCALE_STRENGTH=0.35
# H3_LATENT_UPSCALE_PRECISION=fp16
# H3_LATENT_UPSCALE_TEMPORAL_CHUNKING=true
# H3_LATENT_UPSCALE_FORCE_UNLOAD=true

# --- Optional auto-upscale of every generated video ---
# When enabled in Settings > Video, the video upscale pipeline (shared
# UPSCALE settings: engine, resolution, profile) runs on every generated
# video. The original clip is kept so the gallery can compare the pair
# side by side. Off by default; best-effort (a failed upscale keeps the
# base render).
# H3_AUTO_UPSCALE_ENABLED=false

# --- Shared upscale tuning (SeedVR2 / RTX for video, SeedVR2 / Ultimate SD for images) ---
# Upscaling reads the single UPSCALE settings panel (stored in
# data/config.json under imageGeneration). No per-video overrides exist.
# Engine is shared but mapped per medium: videos run SeedVR2
# or fast RTX (default, Ultimate SD falls back to RTX); images run SeedVR2 or
# Ultimate SD (RTX falls back to SeedVR2). RTX video upscale uses the
# multiplier as its scale factor; SeedVR2 uses the target resolution.

# --- Optional gallery video posters ---
# The gallery mints a poster frame for generated videos with ffmpeg when it is
# available on PATH (or pointed to by FFMPEG_PATH). When ffmpeg is unavailable,
# video tiles fall back to a play-icon placeholder. This is not an npm
# dependency â€” it is only used if present.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# --- Model eviction ---
# Ollama and ComfyUI are never resident at the same time. Before any chat work
# JARVIS unloads ComfyUI models; before any image/video generation it unloads
# every chat model Ollama has loaded. There are no memory thresholds to tune.
#
# Unloads are verified, not fire-and-forget: Ollama's keep_alive 0 only schedules
# the eviction, so JARVIS polls /api/ps until the model is actually gone (then
# holds a short settle) before ComfyUI loads. This stops a still-resident
# llama-server from being stacked on top of the video model and freezing the
# machine. Timeout is the max wait for a model to disappear; poll is the
# /api/ps check interval; settle is the pause after the model is gone (and
# after a ComfyUI /free) to let the OS/driver reclaim the memory.
# JARVIS_MODEL_RELEASE_TIMEOUT_MS=30000
# JARVIS_MODEL_RELEASE_POLL_MS=500
# JARVIS_MODEL_RELEASE_SETTLE_MS=1500

# --- Intent Resolver debugging ---
# Set to 1 to print, per turn, the resolved structured intent, the regex/keyword
# evidence, and the final action. Development only; not shown in the UI.
# JARVIS_INTENT_DEBUG=1

# --- Image prompt debugging ---
# Set to 1 to print the resolved image instruction for a character generation,
# including whether clothing/style were explicit or automatically selected.
# Development only; not shown in the UI.
# JARVIS_PROMPT_DEBUG=1

# --- Playground outfit-resolution debugging ---
# Set to 1 to print the environment/outfit compatibility resolution (selected
# pack, environment, scene, initial outfit, adaptations and final outfit) and to
# expose it on the Playground concept card. Development only; never shown to
# normal users and never written into an image prompt.
# JARVIS_PLAYGROUND_DEBUG=1

# --- Creator Studio dialogue debugging ---
# Set to 1 to print the canonical normalized Creator Studio dialogue object
# before the deterministic H3 prompt is assembled, then the final H3 prompt.
# Development only; never shown in the UI and never written into the prompt.
# JARVIS_CREATOR_DEBUG=1

# --- Companion memory storage ---
# Companion/character memory (personality, fictional state and episodic/semantic
# memories) persists to data/companion.json by default. Set an explicit path for
# tests or an alternate location. All companion data stays local.
# COMPANION_PATH=C:\path\to\companion.json

# --- Character life storage ---
# Fictional life state (activity/location/outfit), recent-activity history,
# generated-scene history and pending photo offers persist to
# data/character-life.json by default, kept separate from companion memory. Set
# an explicit path for tests or an alternate location. All data stays local.
# CHARACTER_LIFE_PATH=C:\path\to\character-life.json

# --- Today's Playground daily idea storage ---
# The daily three-idea set (per device session, rotating on the local date)
# persists to data/playground-today.json by default. Set an explicit path for
# tests or an alternate location. All data stays local.
# PLAYGROUND_TODAY_PATH=C:\path\to\playground-today.json
# The local-LLM idea request timeout in milliseconds (default 20000); a timeout
# falls back to the deterministic local idea set.
# PLAYGROUND_TODAY_TIMEOUT_MS=20000

# --- Unified agent runtime (capability routing + durable tasks) ---
# Agent tasks persist to data/agent-tasks.json by default. Set an explicit path
# for tests or an alternate location. Tasks contain the goal, completion
# criteria, plan, progress events, guidance, receipts and grounded summary;
# they never contain provider secrets.
# AGENT_TASKS_PATH=C:\path\to\agent-tasks.json
#
# The read_log tool only reads files explicitly listed here (JSON array of
# { id, label, path }). When unset, only data/comfyui-start.log is permitted.
# The model can never supply a filesystem path; it picks a configured log id.
# AGENT_LOG_FILES=[{"id":"comfyui-start","label":"ComfyUI start log","path":"C:/path/to/comfyui-start.log"}]
#
# Disk inspection scans ONLY these roots (JSON array or path-separated list).
# Default: the project root. Model-supplied paths are impossible.
# AGENT_ALLOWED_ROOTS=["C:/path/to/project","C:/path/to/data"]
#
# Deletion is narrower than reading: these roots must live inside an allowed
# root, and the only delete tool operates on an exact, task-scoped candidate
# list produced by find_temp_files, after explicit approval.
# AGENT_DELETE_ROOTS=["C:/path/to/project/data/tmp"]
#
# Bounds: plan steps, tool calls, per-step time, whole-task time, and concurrent
# tasks per device. Requests are rejected above the character cap.
# AGENT_MAX_STEPS=6
# AGENT_MAX_TOOL_CALLS=8
# AGENT_STEP_TIMEOUT_MS=25000
# AGENT_TASK_TIMEOUT_MS=120000
# AGENT_PLANNER_TIMEOUT_MS=30000
# AGENT_SUMMARY_TIMEOUT_MS=20000
# AGENT_MAX_CONCURRENT=2
# AGENT_MAX_REQUEST_CHARS=2000
#
# Set to 1 to disable capability routing + durable tasks (ordinary chat only).
# JARVIS_AGENT_DISABLED=1
#
# Set to 1 to log tool names and outcome codes (never tool output, arguments or
# secrets). Development only.
# JARVIS_AGENT_DEBUG=1

# --- Character Swap workspace ---
# Project metadata and media live under data/character-swap.json and
# data/character-swap/<project>/ by default. Override for tests or a custom
# data location.
# CHARACTER_SWAP_PATH=C:\path\to\character-swap.json
# CHARACTER_SWAP_DIR=C:\path\to\character-swap
#
# SAM 3.1 checkpoint used to tap and track people.
# CHARACTER_SWAP_SAM_MODEL=sam3.1_multiplex_fp16.safetensors
#
# Bounded tracking job timeout in milliseconds (default 45 minutes).
# CHARACTER_SWAP_TRACK_TIMEOUT_MS=2700000

# --- Character Swap H3 inpaint control ---
# MiniMax H3 Fun ControlNet-Union 2.0. The inpaint branch keeps the source
# video behind the tracked mask so H3 redraws the replacement at the same
# position/scale instead of moving it out of the silhouette.
# H3_FUN_CONTROLNET=minimax_h3_fun_controlnet_union_2.0_pruned_int8_convrot.safetensors
# Lower strength leaves more room for the reference identity; 1.0 forces the
# source body structure most strongly.
# H3_FUN_CONTROL_STRENGTH=0.35
# H3_FUN_CONTROL_END=1
# Keep the source clip as <Video 1>; required for motion/scene continuity.
# H3_FUN_CONTROL_USE_SOURCE_REF=true

# --- Character Swap: Wan Animate 2 (default engine) ---
# Character animation through the native ComfyUI WanAnimate2ToVideo node:
# one reference image follows a performance video, guided by a scene prompt.
# Install the Wan Animate 2 int8 model, UMT5 text encoder, Wan VAE, CLIP Vision H
# and the LightX2V acceleration LoRA from Settings > Setup.
# WAN_ANIMATE_UNET=wan_animate_2_int8_convrot.safetensors
# WAN_ANIMATE_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# WAN_ANIMATE_VAE=wan_2.1_vae.safetensors
# WAN_ANIMATE_CLIP_VISION=clip_vision_h.safetensors
# WAN_ANIMATE_LIGHTX2V_LORA=lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors
# Output budget preset for Wan Animate 2: 480p (default) or 720p. 720p needs more VRAM.
# WAN_ANIMATE_RESOLUTION=480p
# Longest clip the Wan engine processes (seconds). MiniMax H3 stays at 15s.
# WAN_ANIMATE_MAX_SECONDS=15
# Per-window ComfyUI timeout in milliseconds (default 45 minutes).
# WAN_ANIMATE_TIMEOUT_MS=2700000
#
# --- Character Swap: Wan person selection + segmentation (no SAM) ---
# Wan detects people with DWPose and builds the replacement masks from a
# BiRefNet foreground matte (core ComfyUI RemoveBackground node). No SAM is
# used for Wan. Install the 424 MB model from Settings > Setup.
# Background-removal model filename in ComfyUI/models/background_removal.
# CHARACTER_SWAP_MATTE_MODEL=birefnet.safetensors
# Matte frames processed per ComfyUI job (default 32).
# CHARACTER_SWAP_MATTE_CHUNK=32
# Per-chunk matte timeout in milliseconds (default 45 minutes).
# CHARACTER_SWAP_MATTE_TIMEOUT_MS=2700000
# DWPose selection job timeout in milliseconds (default 30 minutes).
# CHARACTER_SWAP_SELECTION_TIMEOUT_MS=1800000
